---
import { paper } from "../data/paper";
---

<article class="publication-row">
  <a
    class="publication-thumbnail"
    href={paper.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Read ${paper.title}`}
  >
    <img
      src={`${import.meta.env.BASE_URL}ai-review-diversity.png`}
      alt="Conceptual illustration of diverse review perspectives converging into similar AI-generated reviews"
      width="1448"
      height="1086"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="publication-content">
    <h3>
      <a href={paper.url} target="_blank" rel="noopener noreferrer">
        {paper.title}
      </a>
    </h3>
    <p class="publication-topics">
      LLM evaluation <span>·</span> AI for science <span>·</span> Peer review
    </p>
    <p class="publication-venue">
      Findings of EMNLP <span class="publication-accepted">Accepted</span>
    </p>
    <p class="publication-abstract">{paper.finding}</p>
    <div class="publication-links">
      <a href={paper.url} target="_blank" rel="noopener noreferrer">
        Paper
      </a>
      <a
        href="https://openreview.net/forum?id=NdDKcU9HlU"
        target="_blank"
        rel="noopener noreferrer"
      >
        OpenReview
      </a>
    </div>
    <figure class="publication-video">
      <video
        controls
        playsinline
        preload="none"
        poster={`${import.meta.env.BASE_URL}videos/Do_AI_Reviewers_Converge_poster.jpg`}
        aria-label={`Research overview: ${paper.title}`}
      >
        <source
          src={`${import.meta.env.BASE_URL}videos/Do_AI_Reviewers_Converge_promo.mp4`}
          type="video/mp4"
        />
        Your browser does not support embedded video.
        <a href={`${import.meta.env.BASE_URL}videos/Do_AI_Reviewers_Converge_promo.mp4`}>
          Watch the research overview
        </a>
      </video>
      <figcaption>Research overview · Do AI Reviewers Converge?</figcaption>
    </figure>
  </div>
</article>
