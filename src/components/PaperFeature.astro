---
import { paper } from "../data/paper";
const { compact = false } = Astro.props;
---

<article class:list={["paper-feature", { "paper-compact": compact }]}>
  <div class="paper-topline">
    <p class="eyebrow">LLM EVALUATION / AI FOR SCIENCE</p>
    <span class="paper-status">{paper.status}</span>
  </div>
  <h3>{paper.title}</h3>
  <p class="paper-summary">{paper.summary}</p>
  {!compact && (
    <>
      <dl class="paper-metrics">
        {paper.metrics.map((metric) => (
          <div>
            <dt>{metric.label}</dt>
            <dd>{metric.value}</dd>
          </div>
        ))}
      </dl>
      <div class="paper-finding">
        <span class="eyebrow">KEY FINDING</span>
        <p>{paper.finding}</p>
      </div>
    </>
  )}
  <div class="paper-links">
    <a
      class="button primary"
      href={paper.url}
      target="_blank"
      rel="noopener noreferrer"
    >
      Read paper (PDF)
    </a>
    {compact && (
      <a class="text-link" href={`${import.meta.env.BASE_URL}research/`}>
        Research overview
      </a>
    )}
  </div>
</article>
