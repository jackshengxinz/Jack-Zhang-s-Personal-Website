---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  ogType,
  sideBarActiveItemID,
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-theme="lofi">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogType={ogType}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a class="wordmark" href={base}>
        <span class="monogram">JZ↗</span>Jack Zhang.
      </a>
      <nav aria-label="Main navigation">
        {[
          ["About", base, "home"],
          ["Research", `${base}research/`, "research"],
          ["Work", `${base}projects/`, "projects"],
          ["Experience", `${base}cv/`, "cv"],
        ].map(([label, href, id]) => (
          <a
            href={href}
            aria-current={id === sideBarActiveItemID ? "page" : undefined}
          >
            {label}
          </a>
        ))}
        <a class="nav-contact" href="mailto:jackshengxinz@gmail.com">
          Let’s talk ↗
        </a>
      </nav>
    </header>
    <main
      id="main"
      class:list={["wrap", { "inner-page": sideBarActiveItemID !== "home" }]}
    >
      <slot />
    </main>
    <footer class="site-footer wrap">
      <a class="wordmark" href={base}>
        Jack Zhang.
      </a>
      <p>AI evaluation. Diverse perspectives. Thoughtful systems.</p>
      <a href="https://github.com/jackshengxinz">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/shengxin-zhang-b707bb280a">
        LinkedIn ↗
      </a>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>
