---
import BaseHead from "../components/BaseHead.astro";
import Icon from "../components/Icon.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";
import { profile } from "../data/site";

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, ogType } =
  Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  ["About", "about-me"],
  ["News", "news"],
  ["Publications", "publications"],
  ["Research", "research"],
  ["Projects", "projects"],
  ["Education", "education"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="site-title" href={base}>{profile.shortName}</a>
        <nav aria-label="Sections">
          {nav.map(([label, id]) => <a href={`${base}#${id}`}>{label}</a>)}
          <a href={`${base}CV.pdf`} target="_blank" rel="noopener">CV</a>
        </nav>
      </div>
    </header>

    <div class="layout">
      <aside class="sidebar">
        <div class="profile">
          <img
            class="avatar"
            src={`${base}avatar.webp`}
            alt={profile.shortName}
            width="600"
            height="600"
            fetchpriority="high"
          />
          <div class="profile-text">
            <h1 class="author-name">{profile.name}</h1>
            <p class="author-bio">{profile.bio}</p>
          </div>
        </div>
        <ul class="author-links">
          <li><Icon name="pin" /><span>{profile.location}</span></li>
          <li><a href={`mailto:${profile.email}`}><Icon name="mail" />Email</a></li>
          <li><a href={`${base}CV.pdf`} target="_blank" rel="noopener"><Icon name="file" />CV</a></li>
          <li><a href={`${base}resume.pdf`} target="_blank" rel="noopener"><Icon name="file" />中文履歷</a></li>
          <li><a href={profile.github}><Icon name="github" />GitHub</a></li>
          <li><a href={profile.linkedin}><Icon name="linkedin" />LinkedIn</a></li>
        </ul>
      </aside>

      <main id="main" class="content">
        <slot />
        <footer class="site-footer">
          © {new Date().getFullYear()} Shengxin Zhang. Layout adapted from
          <a href="https://github.com/RayeRen/acad-homepage.github.io">AcadHomepage</a>.
        </footer>
      </main>
    </div>
  </body>
</html>
