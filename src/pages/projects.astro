---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import PaperFeature from "../components/PaperFeature.astro";
---

<BaseLayout
  title="Research & Projects | Jack Zhang"
  sideBarActiveItemID="projects"
  description="Explore Jack Zhang's accepted Findings of EMNLP paper, research on fairness and speaker representations, and full-stack and FPGA engineering projects."
>
  <div class="page-intro">
    <p class="eyebrow">RESEARCH & ENGINEERING</p>
    <h1>Research & projects.</h1>
    <p>
      Evaluating how AI judges science. Learning fairly under changing
      populations. Building the systems that put ideas into practice.
    </p>
  </div>
  <nav class="project-jump-links" aria-label="Project sections">
    <a href="#paper">01 / Accepted paper</a>
    <a href="#ml-research">02 / ML research</a>
    <a href="#engineering">03 / Engineering</a>
  </nav>
  <section id="paper" class="portfolio-section" aria-labelledby="paper-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / ACCEPTED PAPER</p>
        <h2 id="paper-heading">Diversity in AI peer review</h2>
      </div>
    </div>
    <PaperFeature />
    <p class="project-section-note">
      Research focus: LLM evaluation, AI for science, and diversity of judgment.{" "}
      <a class="text-link" href={`${import.meta.env.BASE_URL}research/`}>
        Research overview ↗
      </a>
    </p>
  </section>
  <section
    id="ml-research"
    class="portfolio-section"
    aria-labelledby="projects-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / MACHINE LEARNING RESEARCH</p>
        <h2 id="projects-title">Fairness & robust representations</h2>
      </div>
    </div>
    <p class="portfolio-intro">
      Two complementary questions: how models behave across changing
      populations, and how they learn useful representations from variable
      signals.
    </p>
    <ProjectGrid group="research" detailed />
  </section>
  <section
    id="engineering"
    class="portfolio-section"
    aria-labelledby="engineering-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / ENGINEERING</p>
        <h2 id="engineering-title">From hardware to applications</h2>
      </div>
    </div>
    <p class="portfolio-intro">
      Hands-on projects connecting real-time interaction, database logic, and
      user-facing software.
    </p>
    <ProjectGrid group="engineering" detailed />
  </section>
  <aside class="project-contact">
    <div>
      <h2>Interested in the work?</h2>
      <p>
        Get in touch about research questions, technical details, or
        collaboration.
      </p>
    </div>
    <a class="button primary" href="mailto:jackshengxinz@gmail.com">
      Contact me ↗
    </a>
  </aside>
</BaseLayout>
