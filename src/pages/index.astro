---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import ResearchPublication from "../components/ResearchPublication.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout sideBarActiveItemID="home">
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">● &nbsp; MS ECE STUDENT · UIUC</p>
      <h1>
        Hi, I’m Jack.
        <br />I study how
        <br />
        AI <em>evaluates.</em>
      </h1>
      <p class="hero-description">
        I’m an M.S. student in Electrical and Computer Engineering at the
        University of Illinois Urbana-Champaign, advised by Varun
        Chandrasekaran. My research explores diversity in AI-generated peer
        review, fairness under distribution shift, and robust representations. I
        combine statistical thinking with hands-on engineering to understand how
        intelligent systems behave—and how to improve them.
      </p>
      <div class="actions">
        <a class="button primary" href="#featured-research">
          Explore my research
        </a>
        <a
          class="button secondary"
          href={`${base}CV.pdf`}
          target="_blank"
          rel="noopener noreferrer"
        >
          View CV
        </a>
      </div>
      <div class="hero-note">
        University of Illinois Urbana-Champaign
        <br />
        M.S. in Electrical and Computer Engineering
        <br />
        Advisor: Varun Chandrasekaran
      </div>
    </div>
    <div class="portrait-composition">
      <div class="portrait-frame">
        <img
          src={`${base}profile-2026.jpg`}
          alt="Jack Zhang"
          width="1440"
          height="2023"
          fetchpriority="high"
        />
        <span class="portrait-caption">JACK / SHENGXIN ZHANG</span>
      </div>
      <div class="portrait-note">
        <span>✳</span>
        <p>
          Curiosity in research.
          <br />
          Care in what I build.
        </p>
      </div>
      <small>01 / A LITTLE ABOUT ME</small>
    </div>
  </section>
  <div class="focus-strip">
    <span class="eyebrow">CURRENT EXPLORATIONS</span>
    <span>✳ LLM evaluation</span>
    <span>✳ Fairness-aware learning</span>
    <span>✳ Robust representations</span>
  </div>
  <section id="featured-research" class="featured-research research-showcase">
    <div class="section-heading">
      <div>
        <h2>Research</h2>
      </div>
      <a class="text-link" href={`${base}research/`}>
        Research
      </a>
    </div>
    <ResearchPublication />
  </section>
  <section id="selected-work" class="work-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / SELECTED PROJECTS</p>
        <h2>Ideas into practice.</h2>
      </div>
      <a class="text-link" href={`${base}projects/`}>
        All projects
      </a>
    </div>
    <ProjectGrid />
  </section>
  <section class="about-section">
    <div>
      <p class="eyebrow">03 / MY APPROACH</p>
      <h2>
        From the model
        <br />
        to the system.
      </h2>
    </div>
    <div>
      <p class="about-lead">
        I’m interested in what happens when machine learning meets the
        complexity of the real world.
      </p>
      <p>
        My work connects LLM evaluation, speaker recognition, and algorithmic
        fairness under distribution shift. With a background in computer
        engineering and statistics, I bring both empirical analysis and
        practical system-building to these questions. At Shanghai AI Laboratory,
        my work in summer 2026 focused on chemical experiment simulation with
        Isaac Sim and the generation of 3D scientific assets.
      </p>
      <a class="text-link" href={`${base}cv/`}>
        More about my experience
      </a>
    </div>
  </section>
  <section class="contact-section">
    <p class="eyebrow">LET’S CONNECT</p>
    <h2>
      Good work starts
      <br />
      with a conversation.
    </h2>
    <a class="contact-email" href="mailto:jackshengxinz@gmail.com">
      jackshengxinz@gmail.com
    </a>
    <div class="contact-links">
      <a href="mailto:sz68@illinois.edu">University email</a>
      <a href="https://www.linkedin.com/in/shengxin-zhang-b707bb280a">
        LinkedIn
      </a>
      <a href={`${base}resume.pdf`} target="_blank" rel="noopener noreferrer">
        中文履歷
      </a>
    </div>
  </section>
</BaseLayout>
