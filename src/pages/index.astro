---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout sideBarActiveItemID="home">
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">● &nbsp; COMPUTER ENGINEERING · UIUC</p>
      <h1>
        Hi, I’m Jack.
        <br />I build systems
        <br />
        that <em>learn.</em>
      </h1>
      <p class="hero-description">
        At the intersection of machine learning, statistical thinking, and
        hands-on engineering. Exploring how intelligent systems can become more
        robust, fair, and useful.
      </p>
      <div class="actions">
        <a class="button primary" href="#selected-work">
          Explore my work ↘
        </a>
        <a
          class="button secondary"
          href={`${base}CV.pdf`}
          target="_blank"
          rel="noopener noreferrer"
        >
          View CV ↗
        </a>
      </div>
      <div class="hero-note">
        University of Illinois Urbana-Champaign
        <br />
        Computer Engineering · Statistics
      </div>
    </div>
    <div class="portrait-composition">
      <div class="portrait-frame">
        <img
          src={`${base}profile.webp`}
          alt="Jack Zhang"
          width="600"
          height="700"
          fetchpriority="high"
        />
        <span class="portrait-caption">JACK / SHENGXIN ZHANG</span>
      </div>
      <div class="portrait-note">
        <span>✳</span>
        <p>
          Curiosity in research.
          <br />
          Care in what I build.
        </p>
      </div>
      <small>01 / A LITTLE ABOUT ME</small>
    </div>
  </section>
  <div class="focus-strip">
    <span class="eyebrow">CURRENT EXPLORATIONS</span>
    <span>✳ Robust representations</span>
    <span>✳ Fairness-aware learning</span>
    <span>✳ Intelligent systems</span>
  </div>
  <section id="selected-work" class="work-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2>Ideas into practice.</h2>
      </div>
      <a class="text-link" href={`${base}projects/`}>
        All projects ↗
      </a>
    </div>
    <ProjectGrid />
  </section>
  <section class="about-section">
    <div>
      <p class="eyebrow">02 / MY APPROACH</p>
      <h2>
        From the model
        <br />
        to the system.
      </h2>
    </div>
    <div>
      <p class="about-lead">
        I’m interested in what happens when machine learning meets the
        complexity of the real world.
      </p>
      <p>
        My work spans speaker recognition, algorithmic fairness under
        distribution shift, and data-driven applications. A background in
        computer engineering and statistics shapes how I approach both the model
        and the system around it.
      </p>
      <a class="text-link" href={`${base}cv/`}>
        More about my experience ↗
      </a>
    </div>
  </section>
  <section class="contact-section">
    <p class="eyebrow">LET’S CONNECT</p>
    <h2>
      Good work starts
      <br />
      with a conversation.
    </h2>
    <a class="contact-email" href="mailto:jackshengxinz@gmail.com">
      jackshengxinz@gmail.com ↗
    </a>
    <div class="contact-links">
      <a href="mailto:sz68@illinois.edu">University email ↗</a>
      <a href="https://www.linkedin.com/in/shengxin-zhang-b707bb280a">
        LinkedIn ↗
      </a>
      <a href={`${base}resume.pdf`} target="_blank" rel="noopener noreferrer">
        中文履歷 ↗
      </a>
    </div>
  </section>
</BaseLayout>
