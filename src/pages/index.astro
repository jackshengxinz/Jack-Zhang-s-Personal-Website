---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  profile,
  interests,
  news,
  publications,
  research,
  projects,
  education,
  teaching,
  skills,
} from "../data/site";
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section id="about-me">
    <h2>About Me</h2>
    <p>
      I’m an M.S. student in Electrical and Computer Engineering at the
      University of Illinois Urbana-Champaign, advised by
      <a href={profile.advisor.url}>Prof. {profile.advisor.name}</a>. I
      received my B.S. in Computer Engineering with a minor in Statistics from
      UIUC in 2026.
    </p>
    <p>
      I’m interested in when language models make confident but unreliable
      judgments, and how to design evaluations that catch those failures. I’m
      also exploring how AI agents use tools, check their work and recover when
      a plan fails, and how embodied agents use feedback from simulation and
      the physical world.
    </p>
    <p class="interests">
      <strong>Research interests:</strong>
      {interests.join(", ")}.
    </p>
  </section>

  <section id="news">
    <h2>🔥 News</h2>
    <ul class="news">
      {news.map((n) => (
        <li>
          <em class="date">{n.date}</em>
          <span set:html={n.html} />
        </li>
      ))}
    </ul>
  </section>

  <section id="publications">
    <h2>📝 Publications</h2>
    {publications.map((p) => (
      <article class="paper-box">
        <div class="paper-box-image">
          <span class="badge">{p.badge}</span>
          <img src={`${base}${p.image}`} alt="" width="1448" height="1086" loading="lazy" />
        </div>
        <div class="paper-box-text">
          <h3 class="paper-title">
            <a href={p.links[0].url}>{p.title}</a>
          </h3>
          <p class="authors">
            {p.authors.map((a, i) => (
              <>
                {a === p.me ? <strong>{a}</strong> : a}
                {i < p.authors.length - 1 ? ", " : ""}
              </>
            ))}
          </p>
          <p class="venue"><em>{p.venue}</em></p>
          <p class="paper-links">
            {p.links.map((l) => (
              <a href={l.local ? `${base}${l.url}` : l.url}>[{l.label}]</a>
            ))}
          </p>
          <ul>
            {p.points.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </section>

  <section id="research">
    <h2>🔬 Research Experience</h2>
    {research.map((r) => (
      <div class="entry">
        <div class="entry-head">
          <strong>{r.org}</strong>
          <em class="date">{r.date}</em>
        </div>
        <p class="entry-sub">
          {r.with ? `${r.title}, with ${r.with}` : r.title}
        </p>
        <ul>
          {r.points.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section id="projects">
    <h2>🛠️ Projects</h2>
    {projects.map((p) => (
      <div class="entry">
        <div class="entry-head">
          <strong>
            {p.url ? <a href={p.url}>{p.title}</a> : p.title}
          </strong>
          {p.date && <em class="date">{p.date}</em>}
        </div>
        <p class="entry-sub muted">{p.where}</p>
        <p class="entry-desc">{p.description}</p>
        <p class="tags">
          {p.tags.map((t) => <span>{t}</span>)}
        </p>
      </div>
    ))}
  </section>

  <section id="education">
    <h2>📖 Education</h2>
    {education.map((e) => (
      <div class="entry">
        <div class="entry-head">
          <strong>{e.school}</strong>
          <em class="date">{e.date}</em>
        </div>
        <p class="entry-sub">{e.degree}</p>
        <p class="entry-desc muted">{e.detail}</p>
      </div>
    ))}
  </section>

  <section id="teaching">
    <h2>👨‍🏫 Teaching</h2>
    <ul>
      {teaching.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  <section id="skills">
    <h2>💻 Skills</h2>
    <p>{skills}</p>
  </section>
</BaseLayout>
