---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import PaperFeature from "../components/PaperFeature.astro";
---

<BaseLayout title="Experience | Jack Zhang" sideBarActiveItemID="cv">
  <div class="page-intro">
    <p class="eyebrow">BACKGROUND & EXPERIENCE</p>
    <h1>A foundation for building.</h1>
    <p>M.S. ECE student at UIUC, advised by Varun Chandrasekaran.</p>
    <div class="actions">
      <a
        class="button primary"
        href={`${import.meta.env.BASE_URL}CV.pdf`}
        target="_blank"
        rel="noopener noreferrer"
      >
        View CV
      </a>
      <a
        class="button secondary"
        href={`${import.meta.env.BASE_URL}resume.pdf`}
        target="_blank"
        rel="noopener noreferrer"
      >
        中文履歷
      </a>
    </div>
  </div>
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    I'm Jack Zhang, an M.S. student in Electrical and Computer Engineering at
    the University of Illinois Urbana-Champaign, advised by Varun
    Chandrasekaran. My background is in Computer Engineering and Statistics. My
    research spans LLM-generated peer review, diversity in scientific
    evaluation, fairness-aware learning under distribution shift, and speaker
    representation learning. I also build data-driven applications, connecting
    statistical analysis with full-stack development and system-level
    engineering.
  </div>

  <section class="cv-research" aria-labelledby="cv-research-title">
    <h2 id="cv-research-title">Selected research</h2>
    <PaperFeature compact />
  </section>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="University of Illinois Urbana-Champaign"
      subtitle="Current · M.S. in Electrical and Computer Engineering"
    >
      Advised by Varun Chandrasekaran. Research interests include LLM
      evaluation, diversity in AI-generated peer review, and fairness-aware
      machine learning.
    </TimeLineElement>
    <TimeLineElement
      title="University of Illinois at Urbana-Champaign"
      subtitle="2022 to 2026 · B.S. in Computer Engineering, Minor in Statistics · GPA: 3.85/4.00"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Scientific Simulation & 3D Asset Generation — Shanghai AI Laboratory"
      subtitle="Summer 2026 · Shanghai"
    >
      Worked on simulations of experiments involving chemical phenomena using
      Isaac Sim, alongside the generation of 3D scientific assets.
    </TimeLineElement>
    <TimeLineElement
      title="Research Intern — Multimodal Biometric Representation Learning"
      subtitle="Started April 2025 · Prof. Wenyan Dong, Westlake University · Hangzhou"
    >
      Built speaker recognition models using speaker-invariant deep residual
      frameworks. Improved robustness to background noise and inter-speaker
      variability for real-world audio-based identification.
    </TimeLineElement>

    <TimeLineElement
      title="Research Intern — Fairness-Aware Machine Learning under Distribution Shift"
      subtitle="July to August 2023 · Prof. Pradeep Ravikumar, Carnegie Mellon University"
    >
      Developed fairness-regularized MLPs using PyTorch. Proposed Shifty-Pro
      algorithm to improve demographic parity and generalization across
      population drift scenarios, achieving a 42.7% improvement in fairness
      metrics.
    </TimeLineElement>

    <TimeLineElement
      title="Full-Stack Developer — E-Commerce Inventory Optimization System"
      subtitle="Feb 2025 to May 2025 · Champaign"
    >
      Led backend (Flask + SQL) and frontend (React) development for an
      intelligent order-tracking and analytics system. Designed transaction
      logic, complex queries, and user interfaces for real-time insights.
    </TimeLineElement>
  </div>

  <section class="mb-10" aria-labelledby="additional-experience">
    <h2 id="additional-experience" class="mb-5">
      Teaching & Earlier Experience
    </h2>
    <div class="time-line-container">
      <TimeLineElement
        title="Undergraduate Course Assistant — CS 124, ECE 110, STAT 400"
        subtitle="Started August 2023 · University of Illinois Urbana-Champaign"
      >
        Supported over 100 students through office hours in Java programming,
        circuit analysis, and statistical modeling. Graded coursework, mentored
        new teaching assistants, proctored exams, and coordinated with faculty.
      </TimeLineElement>
      <TimeLineElement
        title="Data Analyst Intern — Shanghai Artificial Intelligence Research Institute"
        subtitle="May to July 2023 · Shanghai"
      >
        Built hospital construction cost regression models and credit card fraud
        detection pipelines, and developed a PyTorch / YOLOv8 soccer player
        detection model.
      </TimeLineElement>
    </div>
  </section>
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      <a href="https://www.ets.org/toefl" target="_blank">
        TOEFL 109
      </a>
    </li>
    <li>
      <a
        href="https://www.coursera.org/specializations/deep-learning"
        target="_blank"
      >
        Deep Learning Specialization (in progress)
      </a>
    </li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>Python</li>
    <li>Java</li>
    <li>C/C++</li>
    <li>SQL</li>
    <li>PyTorch</li>
    <li>SystemVerilog</li>
    <li>React.js</li>
    <li>Flask</li>
    <li>Deep Learning</li>
    <li>LLMs & Gen AI</li>
    <li>LLM Evaluation</li>
    <li>Isaac Sim</li>
    <li>3D Scientific Asset Generation</li>
    <li>Diffusion Models</li>
    <li>Fairness in AI</li>
    <li>Full-stack Development</li>
    <li>Database Design</li>
    <li>Git</li>
  </ul>
</BaseLayout>
