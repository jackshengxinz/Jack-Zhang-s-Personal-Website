---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchPublication from "../components/ResearchPublication.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
---

<BaseLayout
  title="Research | Jack Zhang"
  sideBarActiveItemID="research"
  description="Research on diversity in AI-generated peer review, LLM evaluation, and fairness-aware machine learning by Jack Zhang."
>
  <div class="page-intro">
    <h1>Research</h1>
    <p>
      I’m an M.S. ECE student at the University of Illinois Urbana-Champaign,
      advised by Varun Chandrasekaran. My research focuses on LLM evaluation,
      algorithmic fairness, and robust representations.
    </p>
  </div>
  <section aria-labelledby="manuscripts-title">
    <h2 id="manuscripts-title" class="sr-only">
      Papers & publications
    </h2>
    <ResearchPublication />
  </section>
  <section
    class="research-directions"
    aria-labelledby="research-projects-title"
  >
    <div class="section-heading">
      <h2 id="research-projects-title">Research projects</h2>
    </div>
    <ProjectGrid group="research" detailed />
  </section>
</BaseLayout>
